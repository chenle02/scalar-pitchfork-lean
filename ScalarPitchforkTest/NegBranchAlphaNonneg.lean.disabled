import ScalarPitchfork

/-! Negative control `NegBranchAlphaNonneg`: mutation of `ScalarPitchfork.exists_branch_eventually`.
The transversality hypothesis `0 < alpha` is weakened to `0 ≤ alpha`. For `alpha = 0`,
`R = 0` the field is `-beta z ^ 3`, whose only zero is `z = 0`: no branch exists and the
statement is false.
Must not compile. -/

open Filter
open scoped Topology

theorem ScalarPitchforkTest.negBranchAlphaNonneg (alpha beta C r : ℝ) (R Rs : ℝ → ℝ → ℝ)
    (halpha : 0 ≤ alpha) (hbeta : beta ≠ 0) (hC : 0 ≤ C)
    (hr : 0 < r) (hr1 : r ≤ 1)
    (hRval : ∀ e z, |e| ≤ r → |z| ≤ r →
      |R e z| ≤ C * (|z| * e ^ 2 + |z| ^ 3 * |e| + z ^ 4))
    (hRder : ∀ e z, |e| ≤ r → |z| ≤ r → HasDerivAt (R e) (Rs e z) z)
    (hRs : ∀ e z, |e| ≤ r → |z| ≤ r →
      |Rs e z| ≤ C * (e ^ 2 + z ^ 2 * |e| + |z| ^ 3)) :
    ∀ᶠ tau in 𝓝 (0 : ℝ), 0 < tau * beta →
      ∀ sgn : ℝ, (sgn = 1 ∨ sgn = -1) → ∃ z, 0 < sgn * z ∧
        alpha * tau * z - beta * z ^ 3 + R tau z = 0 ∧
        |(|z| - Real.sqrt (alpha * tau / beta))| ≤
          (2 * alpha * (C * (2 * (|beta| + 2 * C) / alpha + 1)) *
              (3 * |beta| / (2 * alpha) + 1) / |beta| ^ 2) * |tau| ∧
        deriv (fun z => alpha * tau * z - beta * z ^ 3 + R tau z) z * beta < 0 := by
  exact ScalarPitchfork.exists_branch_eventually alpha beta C r R Rs halpha hbeta hC hr
    hr1 hRval hRder hRs
