import ScalarPitchfork

/-! Negative control `NegStabilityWrongSign`: mutation of `ScalarPitchfork.exists_branch_eventually`.
Stability sign flipped: `0 < deriv f z * beta` instead of `deriv f z * beta < 0`. On the exact
cubic `deriv f z = -2 alpha tau` at a branch, so `deriv f z * beta = -2 alpha (tau beta) < 0`;
the positive sign is false.
Must not compile. -/

open Filter
open scoped Topology

theorem ScalarPitchforkTest.negStabilityWrongSign (alpha beta C r : ℝ) (R Rs : ℝ → ℝ → ℝ)
    (halpha : 0 < alpha) (hbeta : beta ≠ 0) (hC : 0 ≤ C)
    (hr : 0 < r) (hr1 : r ≤ 1)
    (hRval : ∀ e z, |e| ≤ r → |z| ≤ r →
      |R e z| ≤ C * (|z| * e ^ 2 + |z| ^ 3 * |e| + z ^ 4))
    (hRder : ∀ e z, |e| ≤ r → |z| ≤ r → HasDerivAt (R e) (Rs e z) z)
    (hRs : ∀ e z, |e| ≤ r → |z| ≤ r →
      |Rs e z| ≤ C * (e ^ 2 + z ^ 2 * |e| + |z| ^ 3)) :
    ∀ᶠ tau in 𝓝 (0 : ℝ), 0 < tau * beta →
      ∀ sgn : ℝ, (sgn = 1 ∨ sgn = -1) → ∃ z, 0 < sgn * z ∧
        alpha * tau * z - beta * z ^ 3 + R tau z = 0 ∧
        |(|z| - Real.sqrt (alpha * tau / beta))| ≤
          (2 * alpha * (C * (2 * (|beta| + 2 * C) / alpha + 1)) *
              (3 * |beta| / (2 * alpha) + 1) / |beta| ^ 2) * |tau| ∧
        0 < deriv (fun z => alpha * tau * z - beta * z ^ 3 + R tau z) z * beta := by
  exact ScalarPitchfork.exists_branch_eventually alpha beta C r R Rs halpha hbeta hC hr
    hr1 hRval hRder hRs
